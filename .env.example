# ---------------------------------------------------------------------------
# LOKY AI Next - server configuration
# Copy this file to .env and fill in real values.  .env is gitignored.
# NEVER put these values in public/ or any frontend file.
# ---------------------------------------------------------------------------

# Which provider preset to use. Built-in presets:
#   openai | groq | openrouter | mistral | together | deepseek | gemini | ollama | custom
AI_PROVIDER=openai

# The API key. Falls back to the preset's conventional variable name
# (e.g. OPENAI_API_KEY, GROQ_API_KEY, GEMINI_API_KEY ...) when left empty.
# Ollama runs locally and needs no key.
AI_API_KEY=

# Optional overrides - leave empty to use the preset defaults.
AI_BASE_URL=
AI_MODEL=
AI_SYSTEM_PROMPT=

# Generation tuning.
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
# Give up if the provider does not answer within this many milliseconds.
AI_TIMEOUT_MS=60000

# HTTP + abuse protection.
PORT=3000
HOST=0.0.0.0
# Requests allowed per IP per window (a "request" = one AI answer).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
# Largest accepted conversation payload, in characters.
MAX_INPUT_CHARS=24000

# Example: run locally with Ollama (no API key, no cost)
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Mini Chat (real multi-user messaging) - Supabase FREE tier
# Project URL plus the PUBLIC publishable/anon key only.
# NEVER put the service_role / secret key here: it bypasses every RLS policy.
# Leave both empty to disable Mini Chat; the rest of the app is unaffected.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://jqnzfuimnkghwqccyosw.supabase.co
SUPABASE_ANON_KEY=

# These two public values are served to browsers via GET /api/supabase-config.
# server/config.js refuses to load a key whose JWT role is not "anon", so the
# route answers 503 rather than shipping anything privileged.
